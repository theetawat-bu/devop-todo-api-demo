# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามต้องการ
NODE_ENV=development
PORT=3000
APP_VERSION=dev

# ค่าที่ docker compose ใช้สร้าง Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=app_password
POSTGRES_DB=tododb

# รันในเครื่อง (ไม่ผ่าน docker) ใช้ localhost
DATABASE_URL=postgresql://app:app_password@localhost:5432/tododb?schema=public

# รันใน docker compose ให้ host เป็นชื่อ service คือ db
# DATABASE_URL=postgresql://app:app_password@db:5432/tododb?schema=public
