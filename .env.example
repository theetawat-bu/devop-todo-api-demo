# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามต้องการ
PORT=3000
APP_VERSION=dev

# ค่าที่ docker compose ใช้สร้าง Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=app_password
POSTGRES_DB=tododb

# รันในเครื่อง (ไม่ผ่าน docker) ใช้ localhost
DATABASE_URL=postgresql://app:app_password@localhost:5432/tododb

# รันใน docker compose ให้ host เป็นชื่อ service คือ db
# DATABASE_URL=postgresql://app:app_password@db:5432/tododb

# ─── ตัวอย่างเมื่อใช้ Neon (cloud) ───────────────────────────
# Neon ให้ connection string มา 2 เส้น ใช้คนละงาน:
#   migration (golang-migrate) → เส้น direct (ไม่มี -pooler)
#   แอปตอนรัน → เส้น pooled (มี -pooler) รองรับ connection เยอะกว่า
# ต้องมี ?sslmode=require เสมอ ไม่งั้นต่อไม่ติด
#
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/todo_prod?sslmode=require
# DIRECT_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/todo_prod?sslmode=require
